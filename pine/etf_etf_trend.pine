//@version=6
// GENERATED by Weathervane (weathervane/pine.py). Generated, do not edit. Regenerate with: python -m weathervane pine
// Portfolio: etf   Sleeve: etf_trend   Champion: seed-etf   Generated: 2026-10-29
// Entry: ma_cross(kind=ema, fast=50, slow=200)
// Filters: none
// Exit: stop 3.0 ATR, trail 4.0 ATR, reverse on opposite
// ATR length 20, direction both. Daily bars only. Paper trading research, not advice.
// Instruments and TradingView symbols (cost = round-trip estimate in bps, half is charged per order):
//   SPY      AMEX:SPY           2 bps   US listed ETF, whole shares on Alpaca paper
//   EFA      AMEX:EFA           2 bps   US listed ETF, whole shares on Alpaca paper
//   EEM      AMEX:EEM           2 bps   US listed ETF, whole shares on Alpaca paper
//   IEF      NASDAQ:IEF         2 bps   US listed ETF, whole shares on Alpaca paper
//   TLT      NASDAQ:TLT         2 bps   US listed ETF, whole shares on Alpaca paper
//   LQD      AMEX:LQD           2 bps   US listed ETF, whole shares on Alpaca paper
//   GLD      AMEX:GLD           2 bps   US listed ETF, whole shares on Alpaca paper
//   DBC      AMEX:DBC           2 bps   US listed ETF, whole shares on Alpaca paper
//   VNQ      AMEX:VNQ           2 bps   US listed ETF, whole shares on Alpaca paper
//   UUP      AMEX:UUP           2 bps   US listed ETF, whole shares on Alpaca paper
// Apply to one symbol on a 1D chart. Set Properties > Commission to that symbol's half cost if it differs from the default.

strategy("Weathervane etf/etf_trend", shorttitle = "WV etf/etf_trend", overlay = true, process_orders_on_close = false, calc_on_every_tick = false, pyramiding = 0, initial_capital = 100000,
     commission_type = strategy.commission.percent, commission_value = 0.01, default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = 0, margin_short = 0, fill_orders_on_standard_ohlc = true, max_bars_back = 1000)

// ---- inputs (defaults are the champion's live parameters)
i_direction = input.string("both", "Direction", options = ["both", "long", "short"], group = "Risk and direction")
i_risk = input.float(0.5, "Risk per trade (% of equity)", minval = 0.01, maxval = 5.0, step = 0.05, group = "Risk and direction")
i_atr_len = input.int(20, "ATR length (sizing, stops)", minval = 2, maxval = 400, group = "Risk and direction")
i_entry_kind = input.string("ema", "Entry kind", options = ["ema", "sma"], group = "Entry")
i_entry_fast = input.int(50, "Entry fast", minval = 2, maxval = 400, group = "Entry")
i_entry_slow = input.int(200, "Entry slow", minval = 2, maxval = 400, group = "Entry")
i_stop_atr = input.float(3.0, "Stop (ATR multiples)", minval = 0.5, maxval = 10.0, step = 0.05, group = "Exit")
i_trail_atr = input.float(4.0, "Trailing stop (ATR multiples)", minval = 0.5, maxval = 10.0, step = 0.05, group = "Exit")
i_reverse = input.bool(true, "Reverse on opposite signal", group = "Exit")

f_ma(string kind, float src, int len) =>
    float s = ta.sma(src, len)
    float e = ta.ema(src, len)
    kind == "sma" ? s : e

// ---- entry signals on the close of bar t
atrv = ta.atr(i_atr_len)
maFast = f_ma(i_entry_kind, close, i_entry_fast)
maSlow = f_ma(i_entry_kind, close, i_entry_slow)
longRaw = ta.crossover(maFast, maSlow)
shortRaw = ta.crossunder(maFast, maSlow)
longSig = longRaw and true and i_direction != "short"
shortSig = shortRaw and true and i_direction != "long"
validAtr = not na(atrv) and atrv > 0
goLong = longSig and not shortSig and validAtr
goShort = shortSig and not longSig and validAtr
sig = goLong ? 1 : goShort ? -1 : 0

// ---- exit signals (market exit at the next open)
xLong = false
xShort = false

// ---- position state after bar t's fills
posSize = strategy.position_size
inPos = posSize != 0.0
side = posSize > 0 ? 1 : posSize < 0 ? -1 : 0
barsHeld = inPos ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
var float stopLvl = na
var float tgtLvl = na
var float extreme = na

// ---- extreme since the fill bar and trailing stop, updated on bar close, effective next bar
if inPos
    extreme := barsHeld == 0 ? (side > 0 ? high : low) : (side > 0 ? math.max(extreme, high) : math.min(extreme, low))
    if not na(atrv)
        cand = extreme - side * i_trail_atr * atrv
        stopLvl := side > 0 ? math.max(stopLvl, cand) : math.min(stopLvl, cand)

// ---- orders
stopDist = i_stop_atr * atrv
qty = stopDist > 0 ? (strategy.equity * i_risk / 100.0) / (stopDist * syminfo.pointvalue) : 0.0
exitNow = inPos and (side > 0 ? xLong : xShort)
isReverse = inPos and i_reverse and sig == -side
isEntry = (isReverse or (not inPos and sig != 0)) and qty > 0
if isEntry
    stopLvl := close - sig * stopDist
    tgtLvl := na
    if sig > 0
        strategy.entry("L", strategy.long, qty = qty)
        strategy.exit("XL", from_entry = "L", stop = stopLvl, limit = tgtLvl)
    else
        strategy.entry("S", strategy.short, qty = qty)
        strategy.exit("XS", from_entry = "S", stop = stopLvl, limit = tgtLvl)
else if exitNow
    strategy.close_all(comment = "exit")
else if inPos
    if side > 0
        strategy.exit("XL", from_entry = "L", stop = stopLvl, limit = tgtLvl)
    else
        strategy.exit("XS", from_entry = "S", stop = stopLvl, limit = tgtLvl)

// ---- current stop and target of the open position
showLevels = inPos and not isEntry
plot(showLevels ? stopLvl : na, "Stop", color = color.red, style = plot.style_linebr)
plotshape(isEntry and sig > 0, "Long signal", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.tiny)
plotshape(isEntry and sig < 0, "Short signal", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)

